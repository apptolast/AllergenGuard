# keystore.properties.example
#
# Copy to keystore.properties (gitignored) for local release signing of :consumerApp.
# In CI, the deploy-android workflow writes this file from GitHub Actions Secrets.
# If this file is absent, release builds run UNSIGNED (so assembleRelease works without secrets).

storeFile=/absolute/path/to/menufrontend-release.jks
storePassword=REPLACE_ME
keyAlias=menufrontend
keyPassword=REPLACE_ME
