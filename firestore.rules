rules_version = '2';

// Modelo: alérgenos + ingredientes GLOBALES (catálogo de empresa); restaurantes con subcolecciones
// recipes/menus/reviews; users privados. La ESCRITURA de admin se autoriza por WHITELIST de correos
// (colección `whitelist`, gestionada solo desde la consola/Admin SDK), no por self-registration.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Admin autorizado = sesión iniciada cuyo email está en la whitelist.
    function isWhitelisted() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email));
    }

    // Whitelist de registro de admins. Lectura GET por email exacto (el formulario de registro puede
    // comprobar un correo concreto, pero NO listar todos → no expone la lista). Escritura solo desde
    // la consola de Firebase / Admin SDK (nunca desde el cliente).
    match /whitelist/{email} {
      allow get: if true;
      allow list, write: if false;
    }

    // Catálogo legal de alérgenos (14 fijos): lectura pública; escritura solo admin whitelisted.
    match /allergens/{code} {
      allow read: if true;
      allow write: if isWhitelisted();
    }

    // Catálogo global de ingredientes (empresa): lectura pública; escritura solo admin whitelisted.
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if isWhitelisted();
    }

    // Restaurantes + subárbol.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isWhitelisted();

      // Recetas (= platos del cliente): lectura pública; escritura admin whitelisted.
      match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isWhitelisted();
      }

      // Menús: lectura pública; escritura admin whitelisted.
      match /menus/{menuId} {
        allow read: if true;
        allow write: if isWhitelisted();
      }

      // Reseñas (post-MVP): lectura pública; escribe/edita el consumidor dueño.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Datos privados de usuario (perfil de alérgenos, favoritos).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
