rules_version = '2';

// Multi-tenant model. Each ACCOUNT (tenant) owns a private ingredient catalog
// (accounts/{id}/ingredients) and a set of restaurants (kept top-level and tagged with `accountId` so
// the consumer app can read them globally as a public marketplace). Admin access is by MEMBERSHIP
// (memberships/{uid} -> {accountId, role, restaurantIds}); onboarding is by INVITATION
// (invitations/{email}, provisioned by the platform owner from the console/Admin SDK). Roles:
// ACCOUNT_ADMIN (every restaurant + the account's ingredient catalog) and RESTAURANT_MANAGER (only the
// restaurants assigned in their membership).
//
// Cost note: writes do a couple of get()s (membership + parent restaurant). Reads never get() — they are
// public or self. `match /databases/{database}/documents` is database-agnostic, so this same file is
// deployed to both the `(default)` (release) and `debug` databases.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // The caller's own membership (account + role + assigned restaurants). Guard reads with hasMembership().
    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }
    function hasMembership() { return isSignedIn() && exists(membershipPath()); }
    function myMembership() { return get(membershipPath()).data; }

    function isMember(accountId) {
      return hasMembership() && myMembership().accountId == accountId;
    }
    function isAccountAdmin(accountId) {
      return isMember(accountId) && myMembership().role == 'ACCOUNT_ADMIN';
    }
    // Admin of the restaurant's account, or a manager who has that restaurant assigned.
    function canManageRestaurant(restaurantId) {
      let acc = get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.accountId;
      return isAccountAdmin(acc)
        || (isMember(acc)
            && myMembership().role == 'RESTAURANT_MANAGER'
            && restaurantId in myMembership().restaurantIds);
    }
    // The invitation authorizing this user, keyed by their verified token email.
    function myInvitation() {
      return get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data;
    }

    // Accounts: a member reads their own account; provisioning is owner-only (console/Admin SDK).
    match /accounts/{accountId} {
      allow read: if isMember(accountId);
      allow write: if false;

      // Account-private ingredient catalog: members read; only an Account Admin writes.
      match /ingredients/{ingredientId} {
        allow read: if isMember(accountId);
        allow write: if isAccountAdmin(accountId);
      }
    }

    // Restaurants + subtree. Public read (consumer marketplace); writes gated by account/role.
    match /restaurants/{restaurantId} {
      allow read: if true;
      // New restaurant must be stamped with an account the caller administers (no forging another tenant).
      allow create: if isAccountAdmin(request.resource.data.accountId);
      // Can edit if admin/assigned-manager, and cannot move the restaurant to another account.
      allow update: if canManageRestaurant(restaurantId)
        && request.resource.data.accountId == resource.data.accountId;
      allow delete: if isAccountAdmin(resource.data.accountId);

      // Recipes (= the client's dishes): public read; write by admin/assigned-manager of the restaurant.
      match /recipes/{recipeId} {
        allow read: if true;
        allow write: if canManageRestaurant(restaurantId);
      }
      // Menus: public read; write by admin/assigned-manager of the restaurant.
      match /menus/{menuId} {
        allow read: if true;
        allow write: if canManageRestaurant(restaurantId);
      }
      // Consumer reviews (post-MVP): public read; the owning consumer writes/edits their own.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Invitations: per-email GET (the sign-up form checks one address before creating the account); never
    // listed (does not expose the list); written only from the console / Admin SDK.
    match /invitations/{email} {
      allow get: if true;
      allow list, write: if false;
    }

    // Memberships: a user reads only their own and materializes it ONCE from their invitation on first
    // login. The written account/role/restaurantIds MUST equal the invitation keyed by the verified token
    // email, so a user cannot self-promote or grant themselves restaurants. Immutable afterwards (the
    // owner edits memberships via the console).
    match /memberships/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
        && request.resource.data.accountId == myInvitation().accountId
        && request.resource.data.role == myInvitation().role
        && request.resource.data.restaurantIds == myInvitation().restaurantIds;
      allow update, delete: if false;
    }

    // Legal allergen catalog (shared, 14 fixed): public read; seeded by the owner via console/Admin SDK.
    match /allergens/{code} {
      allow read: if true;
      allow write: if false;
    }

    // Private consumer data (allergen profile, favorites).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
