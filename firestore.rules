rules_version = '2';

// Modelo: alérgenos + ingredientes GLOBALES (catálogo de empresa); restaurantes con
// subcolecciones recipes/menus/reviews; users privados. Auth con custom claims (role, accountId).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'ADMIN'; }
    function accountOf(rid) {
      return get(/databases/$(database)/documents/restaurants/$(rid)).data.accountId;
    }

    // Catálogo legal de alérgenos (14 fijos): lectura pública; escritura solo admin.
    match /allergens/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catálogo global de ingredientes (empresa): lectura pública; escritura solo admin.
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restaurantes + subárbol.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAdmin() && request.auth.token.accountId == request.resource.data.accountId;
      allow update, delete: if isAdmin() && request.auth.token.accountId == resource.data.accountId;

      // Recetas (= platos del cliente): lectura pública; escritura admin del account dueño.
      match /recipes/{recipeId} {
        allow read: if true;
        allow write: if isAdmin() && request.auth.token.accountId == accountOf(restaurantId);
      }

      // Menús: lectura pública; escritura admin del account dueño.
      match /menus/{menuId} {
        allow read: if true;
        allow write: if isAdmin() && request.auth.token.accountId == accountOf(restaurantId);
      }

      // Reseñas (post-MVP): lectura pública; escribe/edita el consumidor dueño.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Datos privados de usuario (perfil de alérgenos, favoritos).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
