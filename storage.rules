rules_version = '2';

// Firebase Cloud Storage security rules.
// Dish images are publicly readable (served via tokenized download URLs) but only a provisioned MEMBER
// (admin/manager of any account) may upload them. The bucket is shared by the whole project (Storage is
// not split per named Firestore database), so membership is checked against the canonical `(default)`
// database: a member there is a trusted, owner-provisioned user. (A debug-only member that never signed
// into a release build won't have a `(default)` membership — an accepted dev edge case.) Everything else
// is denied by default.
service firebase.storage {
  match /b/{bucket}/o {

    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/memberships/$(request.auth.uid));
    }

    // Dish images: dish-images/{restaurantId}/{fileName}
    match /dish-images/{restaurantId}/{fileName} {
      allow read: if true;
      allow write: if isMember()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
