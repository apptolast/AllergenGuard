root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_filename = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_chain-method-continuation = disabled
# The codebase exposes MutableStateFlow backing fields as `_state` with a public
# `uiState` (a different name), which this rule does not allow. Matches the
# established MVVM pattern used across every ViewModel.
ktlint_standard_backing-property-naming = disabled

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# ktlint reads .editorconfig directly, so disabling it here skips generated sources for BOTH
# ktlintCheck and ktlintFormat. The plugin's `filter { exclude }` does NOT catch generated sources
# that are the root of their own Kotlin source set (Compose Resources `ActualResourceCollectors.kt`,
# `Res.kt`, KSP `*_Impl`) in ktlint-gradle 14.x. See kmp-recipes: ktlint-exclude-generated-sources.
[**/build/**]
ktlint = disabled

[**/generated/**]
ktlint = disabled
