# consumerApp/fastlane/.env.example
#
# Copy to consumerApp/fastlane/.env (gitignored) so fastlane-dotenv loads it automatically when you
# run any `android` lane from consumerApp/. In CI the workflow exports SUPPLY_JSON_KEY as a job env
# var instead (from the SERVICE_ACCOUNT_GOOGLE_PLAY_CONSOLE_JSON secret).

# Absolute path to the Google Play Console service-account JSON key (Play Console -> Setup ->
# API access). The account needs at least "Release manager" permission on the app.
SUPPLY_JSON_KEY=/absolute/path/to/play-service-account.json
