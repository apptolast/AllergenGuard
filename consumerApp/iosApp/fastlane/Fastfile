# Fastfile — iOS lanes for MenuAdmin (KMP consumerApp/iosApp module).
#
# Tag-driven release model (mirrors the AppToLast FamilyFilm/Municion setup):
#   • marketingVersion (CFBundleShortVersionString) comes from the Git tag (`v1.2.3` -> `1.2.3`).
#   • buildNumber (CFBundleVersion) = latest_testflight_build_number + 1, queried at runtime.
#   • Signing: `match` (readonly on CI) syncs the App Store cert + profile from the shared
#     apptolast/ios-certificates repo.
#   • The Xcode project (ConsumerApp.xcodeproj) is generated by XcodeGen from project.yml and runs
#     a pre-build script that calls `:consumerApp:embedAndSignAppleFrameworkForXcode`, so the KMP
#     framework is compiled + embedded by xcodebuild. prebuild_kotlin_framework only fails fast.
#
# Lanes (run from consumerApp/iosApp):
#   cd consumerApp/iosApp
#   bundle exec fastlane ios bootstrap_match      # one-time: create/update App Store cert + profile
#   bundle exec fastlane ios match_certificates   # sync signing (readonly)
#   bundle exec fastlane ios build                # local Release .ipa (no upload)
#   bundle exec fastlane ios beta                 # build + upload to TestFlight
#   bundle exec fastlane ios release_from_tag     # CI-only: tag -> TestFlight

default_platform(:ios)

IOS_APP_DIR  = File.expand_path("..", __dir__)         # …/MenuAdmin/consumerApp/iosApp
ROOT_DIR     = File.expand_path("../../..", __dir__)   # …/MenuAdmin (where gradlew lives)
XCODEPROJ    = File.join(IOS_APP_DIR, "ConsumerApp.xcodeproj")
SCHEME       = "ConsumerApp"
BUNDLE_ID    = "com.apptolast.menufrontend"
KMP_MODULE   = ":consumerApp"                          # produces ConsumerApp.framework
RELEASE_CONFIG = "Release"
APPSTORE_PROFILE_NAME = "match AppStore #{BUNDLE_ID}"
APPSTORE_SIGNING_XCARGS = "PROVISIONING_PROFILE_SPECIFIER='#{APPSTORE_PROFILE_NAME}'"
METADATA_PATH = File.join(IOS_APP_DIR, "fastlane/metadata")
SCREENSHOTS_PATH = File.join(IOS_APP_DIR, "fastlane/screenshots")

def parse_tag(tag)
  match = tag.to_s.match(/\Av(\d+\.\d+\.\d+(?:[-+][\w.\-]+)?)\z/)
  UI.user_error!("Tag '#{tag}' is not in form `vMAJOR.MINOR.PATCH[-suffix]`") unless match
  match[1]
end

# App Store Connect API key (.p8). CI passes the key as base64; locally the path is read from .env.
def app_store_connect_api_key_token
  key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  key_path  = ENV["ASC_API_KEY_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  key_b64   = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]

  UI.user_error!("APP_STORE_CONNECT_API_KEY_ID not set") if key_id.to_s.empty?
  UI.user_error!("APP_STORE_CONNECT_API_KEY_ISSUER_ID not set") if issuer_id.to_s.empty?
  UI.user_error!("Provide ASC_API_KEY_PATH (local) or APP_STORE_CONNECT_API_KEY_BASE64 (CI)") if key_path.to_s.empty? && key_b64.to_s.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    key_content: key_b64,
    is_key_content_base64: !key_b64.to_s.empty?,
    in_house: false,
  )
end

# Pre-builds the KMP framework so Kotlin errors surface before xcodebuild. The Xcode pre-build
# script handles the actual embed at link time.
def prebuild_kotlin_framework
  gradle(
    task: "#{KMP_MODULE}:linkReleaseFrameworkIosArm64",
    project_dir: ROOT_DIR,
    flags: "--no-configuration-cache",
  )
end

def build_release_ipa
  build_app(
    project: XCODEPROJ,
    scheme: SCHEME,
    configuration: RELEASE_CONFIG,
    export_method: "app-store",
    export_options: { provisioningProfiles: { BUNDLE_ID => APPSTORE_PROFILE_NAME } },
    xcargs: APPSTORE_SIGNING_XCARGS,
    include_bitcode: false,
    include_symbols: true,
    clean: true,
  )
end

platform :ios do

  desc "One-time: create/update App Store cert + provisioning profile in the match repo."
  lane :bootstrap_match do
    api_key = app_store_connect_api_key_token
    match(type: "appstore", readonly: false, force: true, app_identifier: [BUNDLE_ID], api_key: api_key)
  end

  desc "Sync App Store cert + provisioning profile from the match repo (readonly)."
  lane :match_certificates do
    api_key = app_store_connect_api_key_token
    match(type: "appstore", readonly: true, app_identifier: [BUNDLE_ID], api_key: api_key)
  end

  desc "Build a Release .ipa locally (no upload)."
  lane :build do
    prebuild_kotlin_framework
    api_key = app_store_connect_api_key_token
    match(type: "appstore", readonly: true, app_identifier: [BUNDLE_ID], api_key: api_key)
    build_release_ipa
    UI.success "Built .ipa at #{lane_context[SharedValues::IPA_OUTPUT_PATH]}"
  end

  desc "Build & upload to TestFlight. Pass version_name:'X.Y.Z' to set the marketing version."
  lane :beta do |options|
    api_key = app_store_connect_api_key_token

    next_build = latest_testflight_build_number(app_identifier: BUNDLE_ID, api_key: api_key).to_i + 1
    increment_build_number(build_number: next_build, xcodeproj: XCODEPROJ)
    increment_version_number(version_number: options[:version_name], xcodeproj: XCODEPROJ) if options[:version_name]

    prebuild_kotlin_framework
    match(type: "appstore", readonly: true, app_identifier: [BUNDLE_ID], api_key: api_key)
    build_release_ipa

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      skip_submission: true,
    )
    UI.success "Uploaded build #{next_build} to TestFlight."
  end

  desc "CI-only: read the Git tag, increment build number, build, upload to TestFlight."
  lane :release_from_tag do
    setup_ci(keychain_name: "menufrontend-temp.keychain")

    tag = ENV["RELEASE_TAG"] || ENV["GITHUB_REF_NAME"]
    UI.user_error!("RELEASE_TAG/GITHUB_REF_NAME not set — run this from a tag-triggered job") if tag.to_s.empty?

    vname = parse_tag(tag)
    api_key = app_store_connect_api_key_token

    next_build = latest_testflight_build_number(app_identifier: BUNDLE_ID, api_key: api_key).to_i + 1
    increment_version_number(version_number: vname, xcodeproj: XCODEPROJ)
    increment_build_number(build_number: next_build, xcodeproj: XCODEPROJ)

    prebuild_kotlin_framework
    match(type: "appstore", readonly: true, app_identifier: [BUNDLE_ID], api_key: api_key)
    build_release_ipa

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      skip_submission: true,
    )
    UI.success "Uploaded v#{vname} (build #{next_build}) to TestFlight."
  end

  desc "Generate localized App Store screenshots on the simulator. The app's ScreenshotMode skips login and serves demo data; the UI test launches per screen and shoots. Devices/languages live in the Snapfile. Upload afterwards with upload_store_assets."
  lane :screenshots do
    # Fail fast on Kotlin errors before xcodebuild; the UI test builds the simulator framework (Debug).
    gradle(
      task: "#{KMP_MODULE}:linkDebugFrameworkIosSimulatorArm64",
      project_dir: ROOT_DIR,
      flags: "--no-configuration-cache",
    )
    capture_screenshots
    UI.success "Screenshots generated at #{SCREENSHOTS_PATH}"
  end

  desc "Upload App Store metadata + any generated screenshots (no binary, no review submission)."
  lane :upload_store_assets do
    api_key = app_store_connect_api_key_token
    screenshot_files = Dir.glob(File.join(SCREENSHOTS_PATH, "**", "*.{png,jpg,jpeg}"), File::FNM_CASEFOLD)
    skip_screenshots = screenshot_files.empty?
    UI.important "No screenshots under #{SCREENSHOTS_PATH}; uploading metadata only." if skip_screenshots

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: skip_screenshots,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
    UI.success "Uploaded App Store metadata#{skip_screenshots ? "" : " + screenshots"}."
  end

  error do |lane, exception|
    UI.error "Lane `#{lane}` failed: #{exception.message}"
  end
end
