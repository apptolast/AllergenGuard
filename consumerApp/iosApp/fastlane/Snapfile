# Snapfile — fastlane snapshot config for App Store screenshots.
# The app's ScreenshotMode (launch args -screenshotMode/-screenshotScreen) skips login and serves
# in-memory demo data; the UI test (ConsumerAppScreenshots) just launches per screen and shoots.

# MenuFrontend is iPhone-only → one 6.9" device (App Store auto-scales to the other required sizes).
devices([
  "iPhone 16 Pro Max",
])

languages([
  "es-ES",
])

scheme("ConsumerApp")
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# Clean status bar: 9:41, full battery, full signal.
override_status_bar(true)

# Compose + Firebase SPM are heavy; serial simulators are slower but far more stable.
concurrent_simulators(false)
stop_after_first_error(true)

# Stable derived-data path so SPM binary artifacts (Firebase xcframeworks) resolve once and are reused.
derived_data_path("/tmp/menufrontend_snapshot_dd")
number_of_retries(1)
