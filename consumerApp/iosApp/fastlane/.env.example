# consumerApp/iosApp/fastlane/.env.example
#
# Copy to consumerApp/iosApp/fastlane/.env (gitignored) and fill in the values; fastlane-dotenv
# loads them automatically. In CI these are exported as job-level env vars from Actions Secrets.

# --- Apple Developer / App Store Connect identity ---
APPLE_ID=admin@apptolast.com
# developer.apple.com -> Membership -> Team ID
FASTLANE_TEAM_ID=3NXH5U7C5A
# App Store Connect -> Users and Access -> Team ID (leave blank if you only have one team)
FASTLANE_ITC_TEAM_ID=

# --- App Store Connect API key (preferred over Apple ID + 2FA) ---
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
APP_STORE_CONNECT_API_KEY_ID=ABCDEF1234
APP_STORE_CONNECT_API_KEY_ISSUER_ID=12345678-1234-1234-1234-123456789012
# Absolute path to the downloaded .p8 (local runs only; CI uses APP_STORE_CONNECT_API_KEY_BASE64)
ASC_API_KEY_PATH=/absolute/path/to/AuthKey_ABCDEF1234.p8

# --- match (signing certificates + provisioning profiles) ---
MATCH_GIT_URL=https://github.com/apptolast/ios-certificates.git
MATCH_PASSWORD=replace-me-with-the-shared-repo-passphrase
# For CI git access over HTTPS: echo -n "username:PAT" | base64  -> MATCH_GIT_BASIC_AUTHORIZATION
MATCH_GIT_BASIC_AUTHORIZATION=
