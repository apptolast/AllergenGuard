# The .xcodeproj IS committed (like the other AppToLast iOS apps) so it opens directly
# in Android Studio / Xcode. It stays regeneratable from project.yml (`xcodegen generate`).
# The repo-root .gitignore has `*.xcodeproj`; re-include ours here. Only per-user state is ignored.
!ConsumerApp.xcodeproj
!ConsumerApp.xcodeproj/**

# Xcode
xcuserdata/
DerivedData/
build/
*.xcuserstate

# Firebase config — kept out of git like google-services.json (Android). Provided per environment.
# Regenerate: firebase apps:sdkconfig IOS 1:151008360567:ios:bcab3ae9e63b63c9d46e72 --project menusmati
iosApp/GoogleService-Info.plist
