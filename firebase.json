{
    "firestore": [
        {
            "database": "(default)",
            "rules": "firestore.rules",
            "indexes": "firestore.indexes.json"
        },
        {
            "database": "debug",
            "rules": "firestore.rules",
            "indexes": "firestore.indexes.json"
        }
    ],
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "site": "allergenguard-web",
        "public": "adminApp/build/dist/wasmJs/productionExecutable",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
